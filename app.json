{
  "expo": {
    "name": "Futur Génie",
    "slug": "futur-genie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "futurgenie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.futurgenie.app",
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.futurgenie.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autorisez l'accès à l'appareil photo pour photographier une leçon.",
          "photosPermission": "Autorisez l'accès à vos photos pour choisir une photo de la leçon.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e12e274f-82dd-4633-8759-ea5d366f5aa7"
      }
    },
    "owner": "rafik-kellou"
  }
}
