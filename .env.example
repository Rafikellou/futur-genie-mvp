# Copy this file to .env and fill in the values from your Supabase project
# settings (Project Settings > API). The anon key is public by design and
# safe to embed in the client bundle.
#
# Never put a service role key or any LLM provider key here — those are
# server-side secrets and belong in Supabase Edge Function secrets instead.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Base URL where the web build is reachable, used to build a full
# public quiz link (/q/<slug>) shown on native (iOS/Android). Not needed on
# web itself (the browser's own origin is used there). No production domain
# is deployed yet (Milestone 10) — leave empty until one exists, or point it
# at a local/preview URL for testing (e.g. http://192.168.1.10:8081).
EXPO_PUBLIC_APP_URL=
